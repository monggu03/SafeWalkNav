<?xml version="1.0" encoding="utf-8"?>
<!--
기능1: 내 위치 · 주변 장소.

스크롤: 현재 위치(큰 글씨) + 주변 장소 박스 목록 (코드에서 추가). 누르면 그 순간의 시계 방향·거리를 말한다.
아래: 상태 문장(라이브 리전 — TalkBack 이 자동으로 읽는다) + [다시 찾기] [신호등 카메라]
박스를 누르면 그 장소 쪽을 향했을 때 진동한다(방향 찾기). 같은 박스를 다시 누르면 멈춘다.

장소 이름을 자동으로 읽지 않는다 — 사용자가 고른 것만 듣는다(2026-10 요청).
fitsSystemWindows: targetSdk 35+ edge-to-edge 에서 맨 아래 버튼이 제스처 바에 가리지 않게.
-->
<!-- 바깥: 시스템 바 인셋만 받는다(fitsSystemWindows 는 자기 padding 을 인셋으로 덮어쓰므로
     안쪽 여백은 한 단계 안쪽 레이아웃에 둔다). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!--
    2026-10 배치 변경:
     - 위치 제목은 스크롤 안 맨 위. 예전엔 스크롤 밖이라, 큰 글꼴(200%)에서 긴 제목·상태 문장이
       화면을 다 차지해 박스 목록이 0 높이가 되고 아래 버튼이 화면 밖으로 밀렸다.
     - 상태 줄은 스크롤 밖, 버튼 바로 위(늘 보이게 — 라이브 리전은 화면에 보여야 확실히 읽힌다).
       최대 높이 160dp 로 묶어 버튼을 밀어내지 않는다. 넘치면 "…"로 자르지 않고 안에서 스크롤한다
       (코드에서 ScrollingMovementMethod) — 200% 글꼴의 저시력자가 잘린 뒷부분을 읽을 수 있게.
       (예전 maxLines=4 + ellipsize 는 진동 안내처럼 긴 문장의 뒷부분을 눈으로는 볼 수 없었다)
     - 읽는 순서도 맞아진다: 제목 → 첫 장소 박스 → … → 상태 줄 → 버튼.
       예전엔 제목 다음이 상태 줄이라, 방금 라이브 리전으로 들은 요약을 한 번 더 들었다.
    -->
    <ScrollView
        android:id="@+id/scrollPlaces"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:minHeight="72dp"
                android:text="내 위치 확인 중"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/placesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:maxHeight="160dp"
        android:scrollbars="vertical"
        android:textColor="#FFD700"
        android:textSize="20sp" />

    <!--
    아래 버튼 두 개: 왼쪽 [다시 찾기], 오른쪽 [신호등 카메라].
    보행 신호등이 가까우면 홈으로 돌아가지 않고 곧바로 카메라를 켤 수 있게.
    색은 홈 화면 버튼과 같게(카메라 = 흰색) — 같은 기능은 같은 색.
    높이 96dp·최대 2줄: 큰 글꼴에서 "신호등 카메라"가 한 줄에 안 들어가 14sp 까지 줄어들던 것을
    두 줄로 크게 보이게. [다시 찾기] 글자는 상태에 따라 "찾는 중"·"설정 열기"로 바뀐다(코드).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFD700"
            android:text="다시 찾기"
            android:textColor="#000000"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="2sp"
            android:maxLines="2"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="신호등 카메라"
            android:textColor="#000000"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="2sp"
            android:maxLines="2"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
