<?xml version="1.0" encoding="utf-8"?>
<!--
SafeWalk — 카메라 단일 기능 화면.

앱 실행 즉시 후방 카메라 프리뷰가 전체화면으로 뜨고, 그 위에 신호 색 오버레이 + 큰 상태
글씨를 얹는다. 시각장애인은 화면을 안 봐도 음성·진동으로 안내받고, 저시력자/보호자/시연자는
색과 글씨로 상태를 즉시 확인할 수 있다. (도보 내비게이션 UI 는 2026-07 제거.)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 후방 카메라 프리뷰 (코드에서 PreviewView 추가) -->
    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:importantForAccessibility="no" />

    <!-- 신호 색 전체화면 오버레이 (반투명 — 카메라가 비쳐 보임). 코드가 색 갱신. -->
    <View
        android:id="@+id/overlayColorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:importantForAccessibility="no" />

    <!-- 큰 상태 글씨 (빨간불/초록불/안내). 멀리서도 보이게 그림자 + 대형. -->
    <TextView
        android:id="@+id/overlayStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="신호등을 비춰 주세요"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="24dp"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="16"
        tools:text="빨간불 · 정지" />

</FrameLayout>
