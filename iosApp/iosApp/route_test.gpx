<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="SafeWalkNav Test" xmlns="http://www.topografix.com/GPX/1/1">
  <!--
    route_test.gpx — 기본 GPS 흐름 검증용
    출발: 37.561256, 126.99577 (서울 일대 보행 시뮬레이션)
    간격: 5초마다 trkpt → 앱에서 1~2초 간격 updateLocation 로그가 찍혀야 정상
    주의: wpt 태그 사용 금지 — trkpt만 사용해야 순차 재생됨
  -->
  <trk>
    <name>SafeWalkNav Basic Route Test</name>
    <desc>GPS 흐름 · Kalman gain · 기본 위치 추적 검증. 직선 북동 방향 보행.</desc>
    <trkseg>
      <!-- 출발점 — GPS 초기화 확인 -->
      <trkpt lat="37.561256" lon="126.995770"><time>2026-05-20T09:00:00Z</time><hdop>1.2</hdop></trkpt>
      <trkpt lat="37.561300" lon="126.995800"><time>2026-05-20T09:00:05Z</time><hdop>1.2</hdop></trkpt>
      <trkpt lat="37.561350" lon="126.995840"><time>2026-05-20T09:00:10Z</time><hdop>1.3</hdop></trkpt>
      <trkpt lat="37.561400" lon="126.995880"><time>2026-05-20T09:00:15Z</time><hdop>1.2</hdop></trkpt>
      <trkpt lat="37.561450" lon="126.995920"><time>2026-05-20T09:00:20Z</time><hdop>1.1</hdop></trkpt>
      <trkpt lat="37.561500" lon="126.995960"><time>2026-05-20T09:00:25Z</time><hdop>1.2</hdop></trkpt>
      <!-- 횡단보도 진입 구간 -->
      <trkpt lat="37.561600" lon="126.996000"><time>2026-05-20T09:00:30Z</time><hdop>1.3</hdop></trkpt>
      <trkpt lat="37.561700" lon="126.996050"><time>2026-05-20T09:00:35Z</time><hdop>1.2</hdop></trkpt>
      <trkpt lat="37.561800" lon="126.996100"><time>2026-05-20T09:00:40Z</time><hdop>1.4</hdop></trkpt>
      <trkpt lat="37.561900" lon="126.996150"><time>2026-05-20T09:00:45Z</time><hdop>1.3</hdop></trkpt>
      <trkpt lat="37.562000" lon="126.996200"><time>2026-05-20T09:00:50Z</time><hdop>1.2</hdop></trkpt>
    </trkseg>
  </trk>
</gpx>
